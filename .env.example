STRIPE_SECRET_KEY=
# Stripe webhook signing secret for checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Mailtrap SMTP (use the credentials from your Mailtrap inbox)
MAIL_ENABLED=false
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@jobtrack.local
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
