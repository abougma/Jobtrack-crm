POSTGRES_DB=jobtrack
POSTGRES_USER=jobtrack
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=15432
API_PORT=18080
WEB_PORT=5173
JWT_SECRET=change-this-secret-to-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
# Comma-separated e-mails promoted to PLATFORM_ADMIN (empty = no platform admin)
JOBTRACK_ADMIN_EMAILS=
